# Normalize line endings to LF in the repo regardless of platform, so diffs
# stay clean whether checked out on Windows or elsewhere.
* text=auto eol=lf

*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
